# Virtual environment
venv/
.venv/
env/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

# Output files (large/generated) — exclude most
output/*.csv
output/*.pkl
output/*.png
output/*.js
output/*.pdf
output/chess_history.json
output/scrape_health.html
# output/scrape_health.json is deliberately NOT ignored (v3 O3): it is the
# append-only reliability log, and CI runs from a blank checkout. While it was
# ignored, every run started with an empty history, so consecutive-failure and
# success-rate counts could only ever read as a single entry — the subsystem
# reported perfect health through the runs that failed on 07-22 and 07-25.

# But keep these tracked (needed for CI and model training)
!output/daily_scrape.csv
!output/website_data.json
!output/tournament_fees.csv
!output/historical_standings.csv
!output/historical_tournaments.csv
!output/tournament_summary.csv
!output/daily_registration_counts.csv
!output/tournament_metadata.csv
!output/update_log.csv
!output/walk_in_family_stats.csv
!output/walk_in_multipliers.csv
!output/audit_warnings.json

# Data (local dev DB)
*.db
data/
# ...but the externalized site data (L15) is a real tracked deploy asset.
!docs/data/
!docs/data/site_data.js
*.sqlite3

# Environment
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Node (frontend)
node_modules/

# OS
.DS_Store
Thumbs.db

# Pre-audit backups (debug artifacts from one-off data repairs)
# Broadened to catch suffixed variants like *.bak.eb-verify-<date> (G8).
*.bak
*.bak.*
