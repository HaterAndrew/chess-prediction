{
  "name": "chess-ask-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker proxy for the Chess Entry Predictor Ask tab. Holds the Anthropic API key and answers tournament questions over a 5-tool function-calling loop.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
